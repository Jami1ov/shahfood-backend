# ============================================
# ShahFood Backend — .env konfiguratsiya
# Bu faylni .env deb saqlang (hech kimga bermang!)
# ============================================

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase (supabase.com → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# JWT (kamida 32 belgilik tasodifiy matn)
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_key_minimum_32_characters_here

# Telegram bot (@BotFather dan olinadi)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# To'lov tizimlari (keyinroq)
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
